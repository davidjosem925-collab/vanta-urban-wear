# Deterministic generated text, independent of core.autocrlf on checkout.
supabase/seeds/optimized/manifest.json text eol=lf
supabase/seeds/optimized/link-images.pending.sql text eol=lf
supabase/seeds/catalog.example.sql text eol=lf
