# Solo valores públicos del proyecto Supabase; nunca service_role ni secretos.
VITE_SUPABASE_URL=https://evlbfjvvljbkntlozokt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Disabled until SQL, Edge, Turnstile and cron have been manually approved/deployed.
VITE_DEMO_ORDERS_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# Manual activation only after verifying hosted Auth compatibility and stable RP ID.
VITE_ADMIN_PASSKEYS_ENABLED=false
VITE_ADMIN_DEVICE_MFA_ENABLED=false
