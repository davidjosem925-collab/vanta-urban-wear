# Optional portfolio transition: activate ONLY after approving/applying the
# incremental admin_email_access SQL migration and configuring email templates.
VITE_ADMIN_EMAIL_ACCESS_ENABLED=false

# Phase 3: public switch ONLY. Requires both stage-8 migrations + reviewed Edge
# deployments/secrets. Never add MP Access Tokens to VITE_ variables.
VITE_MP_CHECKOUT_ENABLED=false

# Phase 4: optional email capture. Enable only after SQL/Edge/Resend configuration approval.
# Never store Resend API/encryption/worker keys in VITE_ variables.
VITE_DEMO_EMAIL_ENABLED=false
