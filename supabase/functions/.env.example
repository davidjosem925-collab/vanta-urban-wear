# SERVER ONLY. Copy to an ignored work/ env file, never to the frontend root.
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in hosted Edge.
MP_MODE=test
MP_CHECKOUT_ENABLED=false
MP_ACCESS_TOKEN=
MP_TEST_SELLER_ID=
MP_APPLICATION_ID=
MP_WEBHOOK_SECRET=
MP_WORKER_SECRET=
MP_ALLOWED_ORIGIN=
# Existing stage-5 secret, reuse without changing its value (min 32 chars).
DEMO_ACTOR_SECRET=

# Phase 4: actual transactional email only to authorized recipients. Disabled by default.
DEMO_EMAIL_ENABLED=false
DEMO_EMAIL_MODE=portfolio_demo
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEMO_EMAIL_ALLOWED_RECIPIENTS=
DEMO_EMAIL_ENCRYPTION_KEY=
DEMO_EMAIL_WORKER_SECRET=
